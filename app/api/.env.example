# Copy to .env for local development. Never commit .env.
AMBER_ENV=dev
# The browser-facing origin. Locally that's the Next.js dev server, which proxies /api to this API.
AMBER_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth "Web application" client used by your Firebase project's Google provider.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
AMBER_GOOGLE_OAUTH_CLIENT_ID=
AMBER_GOOGLE_OAUTH_CLIENT_SECRET=

# Existing Firebase project (Project settings > General).
AMBER_FIREBASE_PROJECT_ID=
AMBER_FIREBASE_WEB_API_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AMBER_STATE_COOKIE_KEY=

# Refresh-token encryption. Prefer KMS even in dev; the local key is a dev/test fallback only.
# AMBER_TOKEN_KMS_KEY=projects/<project>/locations/<region>/keyRings/amber/cryptoKeys/oauth-tokens
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AMBER_LOCAL_TOKEN_KEY=

# libpq DSN for psycopg2 (never the prod database).
AMBER_DATABASE_DSN=postgresql://amber_app@127.0.0.1:5432/amber_dev
# AMBER_DB_POOL_MIN=1
# AMBER_DB_POOL_MAX=10

# Comma-separated emails that become admins when they sign in.
AMBER_BOOTSTRAP_ADMIN_EMAILS=
# Safari refuses Secure cookies on http://localhost; set false only if you develop in Safari.
# AMBER_COOKIE_SECURE=false

# Proxies whose X-Forwarded-For is trusted for the client IP (audit log, rate limits).
# Locally the Next.js dev server proxies /api from 127.0.0.1. In GCP, use the load balancer's ranges.
AMBER_TRUSTED_PROXIES=127.0.0.1/32

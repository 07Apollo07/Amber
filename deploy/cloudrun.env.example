# Copy to deploy/cloudrun.env (git-ignored). Secret VALUES are not stored here; see `setup`.
PROJECT_ID=
REGION=asia-south1
SQL_INSTANCE=            # name only, as shown in Cloud SQL
GOOGLE_OAUTH_CLIENT_ID=
FIREBASE_PROJECT_ID=
PICKER_API_KEY=          # restricted browser key (not a secret)
BOOTSTRAP_ADMIN_EMAILS=  # comma-separated
AGENT_MODEL_NAME=gemini-2.5-flash
LITELLM_BASE_URL=       # the LiteLLM proxy URL

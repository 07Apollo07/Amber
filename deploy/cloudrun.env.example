# Copy to deploy/cloudrun.env (git-ignored). Secret VALUES are not stored here; see `setup`.
PROJECT_ID=
PUBLIC_BASE_URL=         # custom domain, e.g. https://amber.example.com (default: the web run.app URL)
REGION=asia-southeast1
SQL_INSTANCE=            # name only, as shown in Cloud SQL
GOOGLE_OAUTH_CLIENT_ID=
FIREBASE_PROJECT_ID=
PICKER_API_KEY=          # restricted browser key (not a secret)
BOOTSTRAP_ADMIN_EMAILS=  # comma-separated
AGENT_MODEL_NAME=gemini-2.5-flash   # with LiteLLM, use an id from the proxy's /v1/models (e.g. vertex_ai/gemini-3.5-flash-lite)
LITELLM_BASE_URL=       # the LiteLLM proxy URL
GEMINI_LIVE_MODEL=gemini-3.8-live   # Opal voice; uses the amber-gemini-api-key secret, not LiteLLM
# GEMINI_LIVE_MAX_SESSION_SECONDS=1800  # keep below the Cloud Run --timeout (3600)

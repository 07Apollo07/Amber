# Copy to deploy.env. Never commit it.
AMBER_PUBLIC_BASE_URL=https://amber.example.com
CLOUD_SQL_CONNECTION_NAME=my-project:asia-south1:my-instance
AMBER_DATABASE_DSN=postgresql://amber_app:PASSWORD@cloud-sql-proxy:5432/amber

AMBER_GOOGLE_OAUTH_CLIENT_ID=
AMBER_GOOGLE_OAUTH_CLIENT_SECRET=
AMBER_FIREBASE_PROJECT_ID=
AMBER_FIREBASE_WEB_API_KEY=
AMBER_STATE_COOKIE_KEY=
AMBER_TOKEN_KMS_KEY=projects/<project>/locations/<region>/keyRings/amber/cryptoKeys/oauth-tokens
AMBER_PICKER_API_KEY=
AMBER_GOOGLE_CLOUD_PROJECT_NUMBER=
AMBER_BOOTSTRAP_ADMIN_EMAILS=
AMBER_GEMINI_API_KEY=

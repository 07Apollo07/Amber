# Where the Next.js server (and its /api rewrite) reaches the Amber API.
# Locally: the uvicorn dev server. In GCP: the API's internal URL.
AMBER_API_ORIGIN=http://127.0.0.1:8000
# Optional browser-visible API origin for WebSocket connections (needed only outside the same-origin proxy).
# NEXT_PUBLIC_AMBER_API_ORIGIN=http://127.0.0.1:8000

# Copy to .env for local development. Never commit .env.
AMBER_ENV=dev
# Where `python main.py` listens (defaults shown).
# AMBER_HOST=127.0.0.1
# AMBER_PORT=8000
# The browser-facing origin. Locally that's the Next.js dev server, which proxies /api to this API.
AMBER_PUBLIC_BASE_URL=http://localhost:3000

# PostHog server-side analytics. Required for PostHog in development; optional in production.
AMBER_POSTHOG_API_KEY=<ph_project_token>
AMBER_POSTHOG_HOST=<posthog_host>

# Required in production to authenticate the daily Drive-watch renewal request.
# AMBER_DRIVE_SYNC_ADMIN_SECRET=<random secret>

# Google OAuth "Web application" client used by your Firebase project's Google provider.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
AMBER_GOOGLE_OAUTH_CLIENT_ID=
AMBER_GOOGLE_OAUTH_CLIENT_SECRET=

# Existing Firebase project (Project settings > General).
AMBER_FIREBASE_PROJECT_ID=
AMBER_FIREBASE_WEB_API_KEY=

# Service-account key file for Firebase Admin and KMS (no AMBER_ prefix). A relative path is
# resolved against this api folder. Key files are git-ignored; never commit one.
GOOGLE_APPLICATION_CREDENTIALS=<project>-<key-id>.json

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AMBER_STATE_COOKIE_KEY=

# Refresh-token encryption. Prefer KMS even in dev; the local key is a dev/test fallback only.
# AMBER_TOKEN_KMS_KEY=projects/<project>/locations/<region>/keyRings/amber/cryptoKeys/oauth-tokens
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AMBER_LOCAL_TOKEN_KEY=

# libpq DSN for psycopg2 (never the prod database).
AMBER_DATABASE_DSN=postgresql://amber_app@127.0.0.1:5432/amber_dev

# Optional LiteLLM proxy for the chat agent's models.
# AMBER_LITELLM_BASE_URL=https://your-litellm-proxy.example/v1
# AMBER_LITELLM_API_KEY=

# Opal voice sidekick: Gemini Live via Google AI Studio directly (bypasses LiteLLM).
# The key defaults to AMBER_GEMINI_API_KEY when empty.
AMBER_GEMINI_LIVE_API_KEY=
AMBER_GEMINI_LIVE_MODEL=gemini-3.8-live
# AMBER_GEMINI_LIVE_VOICE=Aoede
# AMBER_GEMINI_LIVE_MAX_SESSION_SECONDS=1800

# Google Picker (Drive file chooser). Create a browser API key in Cloud Console > APIs & Services >
# Credentials, restrict it to your web origin and the Picker API, and enable the Google Picker API.
# The project NUMBER (Cloud Console > Dashboard) is the Picker's app ID.
AMBER_PICKER_API_KEY=
AMBER_GOOGLE_CLOUD_PROJECT_NUMBER=

# Comma-separated emails that become admins when they sign in.
AMBER_BOOTSTRAP_ADMIN_EMAILS=
# Safari refuses Secure cookies on http://localhost; set false only if you develop in Safari.
# AMBER_COOKIE_SECURE=false

# Proxies whose X-Forwarded-For is trusted for the client IP (audit log, rate limits).
# Locally the Next.js dev server proxies /api from 127.0.0.1. In GCP, use the load balancer's ranges.
AMBER_TRUSTED_PROXIES=127.0.0.1/32
